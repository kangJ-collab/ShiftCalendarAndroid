<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/alarmCloseButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="닫기"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="근무별 기상 알람"
            android:textColor="#202428"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alarmPermissionButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="권한"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="근무 시작 몇 분 전이 아니라, 실제로 일어날 시각을 직접 여러 개 등록합니다. 예: 주간 05:10 · 05:20 · 05:30"
        android:textColor="#58636B"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_alarm_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="예약 상태"
            android:textColor="#202428"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmScheduleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="예약된 알람 0개 · 권한/근무표 동기화/설정 확인"
            android:textColor="#58636B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_alarm_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 업데이트"
            android:textColor="#202428"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appCurrentVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="현재 버전"
            android:textColor="#58636B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/appLatestVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="최신 버전 확인 전"
            android:textColor="#58636B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/appUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="업데이트 확인"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알람 방식"
            android:textColor="#202428"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmSoundName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="알람 소리 · 시스템 기본 알람음"
            android:textColor="#58636B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/alarmSoundPickerButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="시스템 알람음 선택"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="워치는 휴대폰 설정과 관계없이 알람 알림을 진동으로 전달합니다."
            android:textColor="#68727A"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/alarmModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/alarmModeSoundVibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="소리+진동" />

            <RadioButton
                android:id="@+id/alarmModeSound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="소리만" />

            <RadioButton
                android:id="@+id/alarmModeVibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="진동만" />
        </RadioGroup>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/alarmSettingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:padding="10dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/alarmTestButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="10초 테스트"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/alarmSaveButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="저장 및 다시 예약"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
