<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/alarmCloseButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="닫기"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="근무별 기상 알람"
            android:textColor="#202428"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alarmPermissionButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="권한"
            android:textAllCaps="false" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="근무 시작 몇 분 전이 아니라, 실제로 일어날 시각을 직접 여러 개 등록합니다."
                android:textColor="#58636B"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/scheduleAccordionHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_alarm_card"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="예약 상태"
                        android:textColor="#202428"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alarmScheduleSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="다음 알람 확인 중..."
                        android:textColor="#68727A"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scheduleAccordionArrow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="#58636B"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scheduleAccordionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:background="@drawable/bg_alarm_card">

                <TextView
                    android:id="@+id/alarmScheduleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="앞으로 예약된 기상 알람 0회"
                    android:textColor="#58636B"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="이 숫자는 설정 개수가 아니라, 앞으로 실제 근무 날짜마다 울리도록 생성된 미래 알람 횟수입니다."
                    android:textColor="#7A8389"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/updateAccordionHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_alarm_card"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="앱 업데이트"
                        android:textColor="#202428"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/updateSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="버전 확인 중..."
                        android:textColor="#68727A"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/updateAccordionArrow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="#58636B"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/updateAccordionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:background="@drawable/bg_alarm_card">

                <TextView
                    android:id="@+id/appCurrentVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="현재 버전"
                    android:textColor="#58636B"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/appLatestVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="최신 버전 확인 전"
                    android:textColor="#58636B"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/appUpdateButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="업데이트 확인"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeAccordionHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_alarm_card"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="알람 방식"
                        android:textColor="#202428"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/modeSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="소리+진동 · 시스템 기본 알람음"
                        android:textColor="#68727A"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/modeAccordionArrow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="#58636B"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeAccordionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:background="@drawable/bg_alarm_card">

                <TextView
                    android:id="@+id/alarmSoundName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="알람 소리 · 시스템 기본 알람음"
                    android:textColor="#58636B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/alarmSoundPickerButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="시스템 알람음 선택"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="워치는 교대달력 알림이 허용되어 있으면 진동 알림을 전달합니다."
                    android:textColor="#68727A"
                    android:textSize="11sp" />

                <RadioGroup
                    android:id="@+id/alarmModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/alarmModeSoundVibrate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="소리+진동" />

                    <RadioButton
                        android:id="@+id/alarmModeSound"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="소리만" />

                    <RadioButton
                        android:id="@+id/alarmModeVibrate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="진동만" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="근무별 알람"
                android:textColor="#202428"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/alarmSettingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:padding="10dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/alarmTestButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="10초 테스트"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/alarmSaveButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="저장 및 다시 예약"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
