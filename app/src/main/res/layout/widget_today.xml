<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetTodayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/bg_widget">
    <TextView android:id="@+id/widgetTodayDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#68727A" android:textSize="12sp" />
    <TextView android:id="@+id/widgetTodayShift" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#202428" android:textSize="24sp" android:textStyle="bold" />
</LinearLayout>
